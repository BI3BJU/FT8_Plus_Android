<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/ansi_white">

    <!-- (1) Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ansi_white"
        android:padding="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_utc_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/utc_time_placeholder"
            android:textColor="@color/ansi_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:paddingBottom="4dp" />

        <!-- LED indicator + callsign, contacts, about buttons (4 evenly distributed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_led_status"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:textColor="@color/ansi_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:background="@color/ansi_black"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_callsign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/ansi_blue"
                android:gravity="center"
                android:lines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/btn_callsign_anonymous"
                android:textColor="@color/ansi_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_grid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/ansi_purple"
                android:gravity="center"
                android:lines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/gui_grid"
                android:textColor="@color/ansi_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_contacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/ansi_yellow"
                android:gravity="center"
                android:lines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/btn_contacts"
                android:textColor="@color/ansi_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_about"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="@color/ansi_teal"
                android:gravity="center"
                android:lines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="ℹ️"
                android:textColor="@color/ansi_white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- (2) History area: no per-entry divider line, matching the Python
         reference which renders a single continuous text area. -->
    <ListView
        android:id="@+id/lv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:background="@color/ansi_white" />

    <!-- (3) TX area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="@color/ansi_white"
        android:gravity="center_horizontal">

        <!-- Input row: beacon button + text field + transmit/stop button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Beacon button: background is toggled at runtime by MainActivity -->
            <Button
                android:id="@+id/btn_beacon"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textColor="@color/ansi_white"
                android:background="@color/ansi_black"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:minWidth="60dp"
                android:layout_marginEnd="8dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_tx_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_transmit_stop"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="&#9654;"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ansi_white"
                android:background="@color/ansi_green"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:minWidth="60dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Stats + frequency + noise: laid out horizontally to match the Python reference. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_byte_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bytes: 0/0"
                android:textSize="12sp"
                android:textColor="@color/ansi_black"
                android:typeface="monospace"
                android:maxLines="1"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_frame_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frames: 0"
                android:textSize="12sp"
                android:textColor="@color/ansi_black"
                android:typeface="monospace"
                android:maxLines="1"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_frequency"
                android:textSize="12sp"
                android:textColor="@color/ansi_black"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/et_tx_freq"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1"
                android:text="1500"
                android:textSize="12sp"
                android:background="@android:drawable/editbox_background"
                android:padding="2dp"
                android:gravity="center"
                android:layout_marginEnd="2dp" />

            <!-- Removed layout_weight and set wrap_content with minWidth=0dp
                 to ensure the full label is not truncated on narrow screens. -->
            <CheckBox
                android:id="@+id/chk_preamble_noise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/label_noise"
                android:textSize="12sp"
                android:enabled="true"
                android:maxLines="1"
                android:layout_marginStart="2dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- (4) Status area: weight=1 so it shares the remaining vertical
         space with the history area, matching the Python reference layout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="4dp"
        android:background="@color/ansi_white">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:background="@color/ansi_white"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/ansi_black"
                android:typeface="monospace"
                android:padding="8dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
